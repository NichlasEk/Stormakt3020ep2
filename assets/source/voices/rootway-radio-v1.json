      "duration_seconds": 7.2
    },
    {
      "id": "roots-secured",
      "role": "ebba",
      "text": "Vi har namnen och vägen vidare. Ta med fyndet. Sedan vill jag veta varför solen går upp i norr på den där kartan.",

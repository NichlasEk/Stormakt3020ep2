      "duration_seconds": 7.9
    },
    {
      "id": "roots-forged",
      "role": "hedvig",
      "text": "Ditt papper säger inget om namnen. Jag måste tyda stenen från början. Det tar längre tid. Fler vakter är på väg.",
      "asset": "assets/audio/voice-roots-forged.ogg",
      "source": "assets/source/voices/roots-forged.wav",

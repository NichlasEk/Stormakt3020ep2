    },
    {
      "id": "roots-names",
      "role": "hedvig",
      "text": "Namnen passar märkena i stenen. Vittnet talade sanning. Jag behöver ett avtryck. Håll vakterna borta en stund.",
      "asset": "assets/audio/voice-roots-names.ogg",
      "source": "assets/source/voices/roots-names.wav",
